{
  "name": "bittergit-marketing",
  "type": "module",
  "private": true,
  "description": "Marketing site for bittergit.com",
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
