#!/usr/bin/env bash
set -euo pipefail

test -n "${VERIFY_BASE_URL:-}" || {
  echo "VERIFY_BASE_URL is required" >&2
  exit 1
}

TIMEOUT_SECONDS="${VERIFY_TIMEOUT_SECONDS:-900}"
POLL_SECONDS="${VERIFY_POLL_SECONDS:-5}"
SMOKE_PATHS="${VERIFY_SMOKE_PATHS:-/,/robots.txt,/sitemap.xml,/llms.txt,/llms-full.txt,/index.md}"
EXPECTED_CSP="default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data:; font-src 'self' data: https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline'; connect-src 'self'; upgrade-insecure-requests"
EXPECTED_PERMISSIONS_POLICY="camera=(), microphone=(), geolocation=(), payment=(), usb=(), accelerometer=(), gyroscope=(), magnetometer=(), interest-cohort=(), browsing-topics=()"

header_value() {
  local name="$1"
  python3 -c 'import sys
target = sys.argv[1].lower()
for line in sys.stdin:
    if ":" not in line:
        continue
    name, value = line.split(":", 1)
    if name.strip().lower() == target:
        print(value.strip(), end="")
        break
' "$name"
}

assert_header() {
  local path="$1"
  local header="$2"
  local expected="$3"
  local url="${VERIFY_BASE_URL%/}${path}"
  local headers
  local observed

  headers="$(curl -fsSL -o /dev/null -D - "$url" | tr -d '\r')"
  observed="$(printf '%s' "$headers" | header_value "$header")"

  if [ "$observed" != "$expected" ]; then
    echo "Unexpected ${header} at ${url}" >&2
    echo "Expected: ${expected}" >&2
    echo "Observed: ${observed:-<missing>}" >&2
    return 1
  fi
}

validate_health_body() {
  local health_url="${VERIFY_BASE_URL%/}/up"
  local expected_sha="${EXPECTED_GIT_SHA:-}"

  curl -fsS "$health_url" | python3 -c 'import json
import sys

expected_sha = sys.argv[1]
try:
    payload = json.load(sys.stdin)
except Exception:
    raise SystemExit("health response is not JSON")

checks = {
    "ok": payload.get("ok") is True,
    "status": payload.get("status") == "ok",
    "service": payload.get("service") == "bittergit.com",
    "hostname": payload.get("hostname") == "bittergit.com",
    "app": payload.get("app") == "BitterGit",
    "release_identity": bool(payload.get("git_sha")) and payload.get("release") == payload.get("git_sha"),
    "secret_material_returned": payload.get("secret_material_returned") is False,
}
if expected_sha:
    checks["expected_release"] = payload.get("git_sha") == expected_sha

failures = [name for name, ok in checks.items() if not ok]
if failures:
    raise SystemExit("/up failed release identity checks: " + ", ".join(failures))
' "$expected_sha"
}

if [ -n "${EXPECTED_GIT_SHA:-}" ]; then
  HEALTH_URL="${VERIFY_BASE_URL%/}/up"
  deadline=$((SECONDS + TIMEOUT_SECONDS))
  matched=0

  parse_git_sha() {
    python3 -c 'import json, sys; data = json.load(sys.stdin); print(data.get("git_sha", ""), end="")' 2>/dev/null || true
  }

  while [ "$SECONDS" -lt "$deadline" ]; do
    body="$(curl -fsS "$HEALTH_URL" 2>/dev/null || true)"
    sha=""

    if [ -n "$body" ]; then
      sha="$(printf '%s' "$body" | parse_git_sha)"
    fi

    if [ "$sha" = "$EXPECTED_GIT_SHA" ]; then
      matched=$((matched + 1))
      if [ "$matched" -ge 2 ]; then
        break
      fi
    else
      matched=0
    fi

    sleep "$POLL_SECONDS"
  done

  if [ "$matched" -lt 2 ]; then
    echo "Timed out waiting for $HEALTH_URL to report git_sha=$EXPECTED_GIT_SHA" >&2
    exit 1
  fi
else
  deadline=$((SECONDS + 60))
  while [ "$SECONDS" -lt "$deadline" ]; do
    if curl -fsS -o /dev/null "${VERIFY_BASE_URL%/}/" 2>/dev/null; then
      break
    fi
    sleep "$POLL_SECONDS"
  done
  curl -fsS -o /dev/null "${VERIFY_BASE_URL%/}/" || {
    echo "Site unreachable at ${VERIFY_BASE_URL}" >&2
    exit 1
  }
fi

OLDIFS="$IFS"
IFS=','
read -r -a paths <<< "$SMOKE_PATHS"
IFS="$OLDIFS"

for path in "${paths[@]}"; do
  test -n "$path" || continue
  curl -fsS -o /dev/null "${VERIFY_BASE_URL%/}${path}"
done

validate_health_body

for path in "/" "/up"; do
  assert_header "$path" "Content-Security-Policy" "$EXPECTED_CSP"
  assert_header "$path" "Strict-Transport-Security" "max-age=31536000; includeSubDomains"
  assert_header "$path" "X-Content-Type-Options" "nosniff"
  assert_header "$path" "X-Frame-Options" "DENY"
  assert_header "$path" "Referrer-Policy" "strict-origin-when-cross-origin"
  assert_header "$path" "Permissions-Policy" "$EXPECTED_PERMISSIONS_POLICY"
done
